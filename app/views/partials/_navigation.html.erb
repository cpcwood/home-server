<nav class='navbar'>
  <%= render partial: 'partials/header_image', locals: { scrollTarget: 'nav-image' } %>
  <div class='nav-title-container'>
    <a href='<%= root_path %>'><%= @site_settings.name %></a>
  </div>
  <% if @user %>
    <div class='username'>
      <a href='<%= admin_path %>'>
        <%= @user.username %>
      </a>
    </div>
  <% end %>
  <section class='nav-menu' data-controller='nav-menu' data-nav-menu-open='false'>
    <div class='nav-top-controls'>
      <button class='theme-toggle' data-controller='theme' data-action='click->theme#toggle' aria-label='Toggle dark mode'>
        <svg class='theme-icon theme-icon-moon' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
          <path d='M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z'></path>
        </svg>
        <svg class='theme-icon theme-icon-sun' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
          <circle cx='12' cy='12' r='5'></circle>
          <line x1='12' y1='1' x2='12' y2='3'></line>
          <line x1='12' y1='21' x2='12' y2='23'></line>
          <line x1='4.22' y1='4.22' x2='5.64' y2='5.64'></line>
          <line x1='18.36' y1='18.36' x2='19.78' y2='19.78'></line>
          <line x1='1' y1='12' x2='3' y2='12'></line>
          <line x1='21' y1='12' x2='23' y2='12'></line>
          <line x1='4.22' y1='19.78' x2='5.64' y2='18.36'></line>
          <line x1='18.36' y1='5.64' x2='19.78' y2='4.22'></line>
        </svg>
      </button>
      <button class='hamburger-container' data-action='click->nav-menu#menuToggle' data-nav-menu-target='navHamburger' aria-label="Open Navigiation Menu">
        <div class='hamburger'>
          <div class='hamburger-bar' id='hamburger-crown'></div>
          <div class='hamburger-bar' id='hamburger-patty'></div>
          <div class='hamburger-bar' id='hamburger-heel'></div>
        </div>
      </button>
    </div>
    <div class='nav-sidebar' data-nav-menu-target='navSidebar'>
      <div class='upper'>
        <a href='<%= root_path %>' class='nav-item'>
          HOME
        </a>
        <a href='<%= about_path %>' class='nav-item'>
          ABOUT
        </a>
        <a href='<%= projects_path %>' class='nav-item'>
          PROJECTS
        </a>
        <a href='<%= posts_path %>' class='nav-item'>
          BLOG
        </a>
        <a href='<%= code_snippets_path %>' class='nav-item'>
          CODE SNIPPETS
        </a>
        <a href='<%= gallery_images_path %>' class='nav-item'>
          GALLERY
        </a>
        <a href='<%= contact_path %>' class='nav-item'>
          CONTACT
        </a>
      </div>
      <div class='lower'>
        <% if @user %>
          <a href='<%= admin_path %>' class='nav-item'>
            ADMIN
          </a>
          <%= form_with(url: '/login', method: :delete, class: 'logout-form') do %>
            <%= submit_tag("LOGOUT", class: 'nav-item', id: 'logout-button') %>
          <% end %>
        <% else %>
          <a href='<%= login_path %>' class='nav-item' id='login-button' rel='nofollow'>
            LOGIN
          </a>
        <% end %>
      </div>
    </div>
    <div class='nav-screen-cover' data-action='click->nav-menu#closeMenu'></div>
  </section>
</nav>
